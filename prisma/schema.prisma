generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("PRISMA_DATABASE_URL") // uses connection pooling
  directUrl = env("DATABASE_URL") // uses a direct connection
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  tokenBalance Int        @default(100000) // 100k free tokens on signup
  // Дневная квота шагов на моделях :free. freeStepsDay — сутки UTC (YYYY-MM-DD),
  // к которым относится freeStepsToday. freeStepsTotal не сбрасывается.
  freeStepsToday Int       @default(0)
  freeStepsDay   String?
  freeStepsTotal Int       @default(0)
  plan         Plan       @default(FREE)
  isBanned     Boolean    @default(false)
  // null — брать LLM_PROVIDER из окружения. Иначе персональный провайдер модели.
  llmProvider  LlmProvider?
  // Какой профиль Bedrock вызывать, если пользователю доступно несколько.
  bedrockModelId String?
  // Лист ожидания платного тарифа: когда нажал «Сообщить о запуске» и куда писать.
  proWaitlistAt      DateTime?
  proWaitlistContact String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  identities    Identity[]
  usageLogs     UsageLog[]
  modelRequests ModelRequest[]
  mediaGenerations MediaGeneration[]
  modelAccess   UserModelAccess[]
  budget        AccountBudget?
}

model Identity {
  id         String   @id @default(uuid())
  userId     String
  provider   String   // e.g., 'yandex', 'vk'
  providerId String   // External ID from the provider
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

// One row per chat-completion attempt, including upstream failures.
// Prompts are not stored.
model ModelRequest {
  id         String   @id @default(uuid())
  userId     String
  model      String
  requestId  String?
  requestedModel String?
  operation  String @default("chat")
  source     String?
  region     String?
  statusCode Int
  durationMs Int
  error      String?
  // Set when a red free model was replaced before this attempt.
  routedFrom String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([model, createdAt])
  @@index([requestId])
  @@index([userId, createdAt])
}

model UsageLog {
  id               String   @id @default(uuid())
  userId           String
  model            String
  promptTokens     Int
  completionTokens Int
  // bedrock или openrouter. Старые строки без источника узнаём по id модели.
  source           String?
  costMicros       Int?
  accounting       String? // reported, estimated, or legacy
  costBasis        String? // provider, catalog, reservation; separate from legacy token-balance accounting
  requestId        String? @unique
  requestedModel   String?
  operation        String @default("chat")
  region           String?
  inputPerMillion  Float?
  outputPerMillion Float?
  unitPriceMicros  Int?
  imageCount       Int @default(0)
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cacheReadTokens Int @default(0)
  cacheWriteTokens Int @default(0)
  cacheReadPerMillion Float?
  cacheWritePerMillion Float?
  chatId String?

  @@index([userId, chatId])

}

// USD micro-units (1 USD = 1,000,000). No conversion of historical tokens to money.
model AccountBudget {
  userId             String   @id
  enabled            Boolean  @default(true)
  balanceMicros      Int      @default(0)
  validUntil         DateTime
  fiveHourLimitMicros Int     @default(2000000)
  weeklyLimitMicros   Int     @default(5000000)
  fiveHourRequestLimit Int    @default(150)
  weeklyRequestLimit Int     @default(1000)
  fiveHourStartedAt  DateTime?
  weeklyStartedAt    DateTime?
  fiveHourUsedMicros Int      @default(0)
  weeklyUsedMicros   Int      @default(0)
  fiveHourRequests   Int      @default(0)
  weeklyRequests     Int      @default(0)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries           BudgetEntry[]
  reservations      BudgetReservation[]
}

model BudgetEntry {
  id           String   @id @default(uuid())
  userId       String
  key          String   @unique // grant/payment/request idempotency key
  amountMicros Int
  kind         String   // grant, reserve, refund, adjustment; future payment/subscription
  note         String
  payloadHash  String?
  createdAt    DateTime @default(now())
  budget       AccountBudget @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@index([userId, createdAt])
}

model BudgetReservation {
  id              String   @id @default(uuid())
  userId          String
  model           String
  source          String
  reservedMicros  Int
  inputPerMillion Float
  outputPerMillion Float
  requestId       String? @unique
  requestedModel  String?
  operation       String @default("chat")
  region          String?
  unitPriceMicros Int?
  imageCount      Int @default(0)
  status          String   @default("pending") // reported, estimated, refunded
  costMicros      Int?
  promptTokens    Int?
  completionTokens Int?
  fiveHourStartedAt DateTime
  weeklyStartedAt DateTime
  createdAt       DateTime @default(now())
  budget          AccountBudget @relation(fields: [userId], references: [userId], onDelete: Cascade)
  @@index([userId, status])
  cacheReadTokens Int @default(0)
  cacheWriteTokens Int @default(0)
  cacheReadPerMillion Float?
  cacheWritePerMillion Float?
  chatId String?

}

// Private results allow safe replay without calling a billed model again. Prompts are not stored.
model MediaGeneration {
  id            String @id @default(uuid())
  userId        String
  requestKey    String
  payloadHash   String
  model         String
  region        String
  status        String @default("pending")
  reservationId String? @unique
  image         Bytes?
  mimeType      String?
  seed          String?
  errorCode     String?
  createdAt     DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, requestKey])
  @@index([userId, createdAt])
}

// Каталог Bedrock. enabled — доступна ли модель всем, у кого нет личного исключения.
model BedrockModel {
  id                   String   @id
  name                 String
  inputPerMillion      Float?
  outputPerMillion     Float?
  enabled              Boolean  @default(false)
  agreementStatus      String?
  authorizationStatus  String?
  regionAvailability   String?
  updatedAt            DateTime @updatedAt

  grants               UserModelAccess[]
}

// Личное исключение. enabled=true открывает модель даже если она выключена для всех.
model UserModelAccess {
  userId   String
  modelId  String
  enabled  Boolean
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  model    BedrockModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@id([userId, modelId])
}

// Лист ожидания Pro с лендинга: человек ещё не пользователь, есть только контакт.
model WaitlistEntry {
  id        String   @id @default(uuid())
  contact   String   @unique // почта или Telegram
  source    String   @default("landing")
  createdAt DateTime @default(now())
}

enum Plan {
  FREE
  PRO
}

enum LlmProvider {
  OPENROUTER
  BEDROCK
}
